#!/usr/bin/env bash
# Blocks commits that touch files you don't own, or that contain secrets.
set -euo pipefail
source "$(git rev-parse --show-toplevel)/scripts/lib.sh"
cd "$ROOT"

if past_cutoff; then
  echo "BLOCKED: it is past the hackathon cutoff ($(cutoff_label)). Nothing may be committed now, or we are disqualified."
  exit 1
fi

files="$(git diff --cached --name-only --diff-filter=ACMRD)"
[[ -z "$files" ]] && exit 0
fail=0

# 1. Secret files and secret strings.
bad_files="$(echo "$files" | grep -E '(^|/)(\.env(\..*)?|GoogleService-Info\.plist|google-services\.json|firebase_options\.dart|.*\.pem|.*\.key|id_rsa.*)$' | grep -vE '\.env\.example$' || true)"
if [[ -n "$bad_files" ]]; then echo "BLOCKED: secret-bearing file staged:"; echo "$bad_files"; fail=1; fi
leaks="$(git diff --cached -U0 | grep -E '^\+' | grep -nE 'AIza[0-9A-Za-z_-]{35}|sk-(ant-|proj-)?[A-Za-z0-9_-]{20,}|gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}|xox[abpr]-[A-Za-z0-9-]{10,}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----' || true)"
if [[ -n "$leaks" ]]; then echo "BLOCKED: possible secret in staged changes (use .env + env vars):"; echo "$leaks" | cut -c1-120; fail=1; fi

# 2. Shared coordination files must stay consistent.
if echo "$files" | grep -qE '^(team/|docs/SPEC.md|contracts/)'; then
  "$ROOT/scripts/check" --quiet || { echo "BLOCKED: fix the consistency errors above before committing."; fail=1; }
fi

# 3. Ownership. The lead, and Yahya (full permission from Ian, Sat 21 Nov 20:13), can bypass with ALLOW_SHARED=1.
if [[ "${ALLOW_SHARED:-}" == 1 && ( "$(me)" == "$(lead)" || "$(me)" == "Yahya-github" ) ]]; then
  :
else
  # shellcheck disable=SC2086
  if ! out="$(echo "$files" | tr '\n' '\0' | xargs -0 "$ROOT/scripts/owns")"; then
    echo "BLOCKED: you are committing files you don't own:"; echo "$out"
    echo "Unstage them and ask the owner on the board: scripts/board post --type NEED --to <owner> \"...\""
    fail=1
  fi
fi
exit $fail
