#!/usr/bin/env bash
# Claude Code PreToolUse hook: refuse edits to files owned by someone else.
source "$(dirname "$0")/lib.sh"
path="$(jq -r '.tool_input.file_path // .tool_input.notebook_path // empty')"
[[ -z "$path" ]] && exit 0
if ! out="$("$ROOT/scripts/owns" "$path")"; then
  echo "$out Don't edit it. Ask the owner instead: scripts/board post --type NEED --to <owner> \"<exact change you need>\"" >&2
  exit 2
fi
exit 0
